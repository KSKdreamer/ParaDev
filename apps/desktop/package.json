{
  "name": "@paradev/desktop",
  "private": true,
  "version": "0.1.0-0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node ../../scripts/sync-gui.mjs",
    "check:package": "node ../../scripts/sync-gui.mjs --check",
    "test": "vitest run",
    "test:model": "vitest run src/moduleEditor/model.test.ts src/projectModules.test.ts src/diagramEditor/layoutModel.test.ts src/diagramEditor/projectDiagram.test.ts src/moduleEditor/diagramSelection.test.ts src/moduleEditor/diagramMetadata.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@uiw/react-codemirror": "^4.25.10",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "react-konva": "^19.2.5",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
